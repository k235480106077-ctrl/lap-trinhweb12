🚀 2. BÀI TẬP 1: Giả lập Linux, Docker Compose & Nginx Virtual Host2.1. Yêu cầuGiả lập OS Linux (WSL / Ubuntu).Cài đặt Docker Compose.Cài đặt 5 dịch vụ: nginx, nodered, mariadb, phpmyadmin, cloudflared.Cấu hình Nginx phục vụ 2 website chạy song song với 2 domain khác nhau (site1.local và site2.local).2.2. File cấu hình Docker Compose (docker-compose.yml)Dự án khởi tạo 5 container chạy ngầm kết nối qua bridge network:YAMLversion: '3.8'

services:
  web_nginx:
    image: nginx:latest
    container_name: web_nginx
    ports:
      - "80:80"
    volumes:
      - ./html:/usr/share/nginx/html
      - ./nginx/conf.d:/etc/nginx/conf.d
    restart: always

  nodered:
    image: nodered/node-red:latest
    container_name: web_nodered
    ports:
      - "1880:1880"
    volumes:
      - nodered_data:/data
    restart: always

  mariadb:
    image: mariadb:latest
    container_name: web_mariadb
    environment:
      MYSQL_ROOT_PASSWORD: rootpassword
      MYSQL_DATABASE: mydatabase
      MYSQL_USER: myuser
      MYSQL_PASSWORD: mypassword
    volumes:
      - mariadb_data:/var/lib/mysql
    restart: always

  phpmyadmin:
    image: phpmyadmin:latest
    container_name: web_phpmyadmin
    ports:
      - "8080:80"
    environment:
      PMA_HOST: mariadb
    depends_on:
      - mariadb
    restart: always

  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: web_cloudflared
    command: tunnel --no-autoupdate run
    restart: always

volumes:
  nodered_data:
  mariadb_data:
